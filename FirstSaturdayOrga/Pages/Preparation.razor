@page "/preparation"

<FSOrga PageTitle="Voorbereiding">
    <RequiredContent>
        <StepCard 
            TitleShort="1. FevGames registratie"
            TitleLong="Stap 1: Registreren bij FevGames"
            Icons="fevgames"
            IsRequiredStep="true"
        >
            <PopupContent>
                <FevGamesRegistrationPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="2. Telegram chats maken"
            TitleLong="Stap 2: Telegram groepen en kanaal aanmaken"
            Icons="telegram"
            IsRequiredStep="true"
        >
            <PopupContent>
                <TelegramChatsPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="3. Aankondiging versturen"
            TitleLong="Stap 3: Aankondiging sturen naar diverse chats"
            Icons="announcement"
            IsRequiredStep="true"
        >
            <PopupContent>
                <AankondigingDelenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="4. FS Bot inrichten"
            TitleLong="Stap 4: FS Bot inrichten"
            Icons="bot"
            IsRequiredStep="true"
        >
            <PopupContent>
                <BotInrichtenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="5. Passcode portals delen"
            TitleLong="Stap 5: Passcode portals delen in passcode chat"
            Icons="passcode"
            IsRequiredStep="true"
        >
            <PopupContent>
                <PasscodePortalsDelenPopup />
            </PopupContent>
        </StepCard>
    </RequiredContent>
    <OptionalContent>
        <StepCard 
            TitleShort="A. Locatie regelen"
            TitleLong="Stap A: Geschikte locatie regelen"
            Icons="beer"
            IsRequiredStep="false"
        >
            <PopupContent>
                <LocatieRegelenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="B. Biocard maken"
            TitleLong="Stap B: Biocard (laten) maken"
            Icons="biocard"
            IsRequiredStep="false"
        >
            <PopupContent>
                <BiocardMakenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="C. Banner(s) maken"
            TitleLong="Stap C: Een of meerdere banners maken"
            Icons="banner"
            IsRequiredStep="false"
        >
            <PopupContent>
                <BannerMakenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="D. Bot reminders schedulen"
            TitleLong="Stap D: Bot reminders schedules"
            Icons="bot"
            IsRequiredStep="false"
        >
            <PopupContent>
                <BotRemindersSchedulenPopup />
            </PopupContent>
        </StepCard>
        <StepCard 
            TitleShort="E. Prijsjes regelen"
            TitleLong="Stap E: Leuke prijsjes regelen"
            Icons="prize"
            IsRequiredStep="false"
        >
            <PopupContent>
                <PrijsjesRegelenPopup />
            </PopupContent>
        </StepCard>
    </OptionalContent>
</FSOrga> 


